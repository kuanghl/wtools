FROM centos:8.4.2105

LABEL maintainer="Semptian"
LABEL description="CentOS 8.5 with configurable vault mirrors (EOL)"

# CentOS 8 is EOL since 2021-12-31, use vault mirrors pinned to 8.5.2111
# repo:/etc/yum.repos.d/
# Aliyun: https://mirrors.aliyun.com/centos-vault/8.5.2111/
# Official: http://vault.centos.org/8.5.2111/
# Set MIRROR=aliyun for Alibaba Cloud mirrors, or MIRROR=official for official vault.
# Example: docker build --build-arg MIRROR=official -t centos8-official .
ARG MIRROR=aliyun

RUN set -eu; \
    case "$MIRROR" in \
      aliyun) BASEURL="https://mirrors.aliyun.com/centos-vault/8.5.2111" ;; \
      official) BASEURL="http://vault.centos.org/8.5.2111" ;; \
      *) echo "Unsupported MIRROR: $MIRROR (use 'aliyun' or 'official')"; exit 1 ;; \
    esac; \
    rm -f /etc/yum.repos.d/*.repo; \
    printf '[baseos]\n\
name=CentOS Linux 8.5.2111 - BaseOS\n\
baseurl=%s/BaseOS/$basearch/os/\n\
gpgcheck=1\n\
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-centosofficial\n' "$BASEURL" > /etc/yum.repos.d/CentOS-Linux-BaseOS.repo; \
    printf '[appstream]\n\
name=CentOS Linux 8.5.2111 - AppStream\n\
baseurl=%s/AppStream/$basearch/os/\n\
gpgcheck=1\n\
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-centosofficial\n' "$BASEURL" > /etc/yum.repos.d/CentOS-Linux-AppStream.repo; \
    printf '[extras]\n\
name=CentOS Linux 8.5.2111 - Extras\n\
baseurl=%s/extras/$basearch/os/\n\
gpgcheck=1\n\
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-centosofficial\n' "$BASEURL" > /etc/yum.repos.d/CentOS-Linux-Extras.repo; \
    printf '[powertools]\n\
name=CentOS Linux 8.5.2111 - PowerTools\n\
baseurl=%s/PowerTools/$basearch/os/\n\
gpgcheck=1\n\
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-centosofficial\n\
enabled=1\n' "$BASEURL" > /etc/yum.repos.d/CentOS-Linux-PowerTools.repo; \
    yum clean all; \
    yum makecache

# Install locale support and yum-utils (for yumdownloader)
RUN yum install -y glibc-langpack-zh yum-utils && \
    yum clean all

CMD ["/bin/bash"]